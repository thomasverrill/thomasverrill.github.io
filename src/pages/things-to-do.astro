---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageNav from "../components/PageNav.astro";
---

<BaseLayout
  title="Things to Do"
  description="Location notes and things to do from Thomas Verrill."
  showHeader={false}
>
  <PageNav
    items={[
      { label: "home", href: "/" },
      { label: "ireland", href: "#ireland" },
      { label: "philadelphia", href: "#philadelphia" },
    ]}
  />

  <h1>things to do</h1>

  <div class="intro">
    <p>
      whenever i visit somewhere new, i spend a lot of time searching for
      good things to do there. this page is an archive of what i've
      personally done and enjoyed — meant to be a helpful reference for
      others too.
    </p>
  </div>

  <section id="ireland" aria-labelledby="ireland-heading">
    <h2 id="ireland-heading">ireland</h2>
    <ul class="archive-list" aria-label="ireland entries">
      <li>
        <a href="https://www.alltrails.com/en-gb/trail/northern-ireland/antrim-and-newtownabbey/causeway-coast-way-dunseverick-castle-to-the-giant-s-causew">causeway hike</a>
        <p class="section-note">
          fairly relaxed hike to the giant's causeway from dunseverick castle.
          stunning views the entire time!
        </p>
      </li>
      <li>
        <a href="https://doolincliffwalk.com/">cliffs of moher walk with pat sweeney</a>
        <p class="section-note">
          the best way to experience the cliffs of moher. reach normally
          unavailable areas and sights with an excellent tour guide who owns
          much of the land.
        </p>
      </li>
      <li>
        <a href="https://dublinpubcrawl.com/">dublin literary pub crawl</a>
        <p class="section-note">
          a great way to experience beautiful, historic pubs in dublin and
          the literary history associated with them. the two tour guides,
          who are working actors, explain and perform the irish literature
          excerpts.
        </p>
      </li>
      <li>
        <a href="https://www.theirishroadtrip.com/caves-of-keash/">keshcorran caves</a>
        <p class="section-note">
          a short hike to a fun set of 17 caves on the edge of a mountain that
          you can walk through.
        </p>
      </li>
      <li>
        <a href="https://www.discoverireland.ie/clare/lough-avalla-farm-loop">lough avalla farm loop</a>
        <p class="section-note">
          a magical hike through deep green wooded areas and open rocky
          terrain. highlights are the holy well and the cottage in the
          middle that serves apple pie, tea, and coffee.
        </p>
      </li>
      <li>
        <a href="https://www.aranislands.ie/inis-mor-inishmore-island/inis-mor-island-natural-features/the-wormhole">the wormhole on inishmore</a>
        <p class="section-note">
          a naturally-formed rectangular hole on the edge of the largest aran
          island.
        </p>
      </li>
    </ul>
  </section>

  <section id="philadelphia" aria-labelledby="philadelphia-heading">
    <h2 id="philadelphia-heading">philadelphia</h2>
    <ul class="archive-list" aria-label="philadelphia entries"></ul>
  </section>
</BaseLayout>
